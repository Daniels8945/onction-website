# Copy to .env and fill in for your environment. Every value has a
# local-dev-safe default in app/config.py, so .env is only required in
# production (the VPS).

# --- Database ---------------------------------------------------------------
# Local dev (default): sqlite:///./onction.db
# Production (Postgres on the VPS): postgresql+psycopg://user:pass@host:5432/onction
DATABASE_URL=

# --- Auth --------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Object storage (Contabo Object Storage — S3-compatible) -----------------
# Contabo's S3 endpoint looks like: https://usc1.contabostorage.com (region-specific)
S3_ENDPOINT_URL=
S3_REGION=us-central-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
# Optional: CDN/reverse-proxy domain in front of the bucket, e.g. https://media.onctionenergy.com
S3_PUBLIC_BASE_URL=

# --- CORS ----------------------------------------------------------------------
# Comma-separated production frontend origin(s), e.g. https://onctionenergy.com
EXTRA_CORS_ORIGINS=

# --- Email (SMTP) --------------------------------------------------------------
# Provider-agnostic: point this at a mail server on the VPS today, or at
# Amazon SES / SendGrid / Mailgun's SMTP relay later — same fields either way.
# NOTE: a bare VPS IP has no sending reputation. For anything beyond
# low-volume transactional mail (enquiry/registration alerts), expect
# deliverability issues sending bulk newsletters this way until SPF/DKIM/
# DMARC are set up for your sending domain, and consider a real ESP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@onctionenergy.com
SMTP_FROM_NAME=Onction Energy
# Where new-enquiry / new-event-registration alerts are sent. Defaults to ADMIN_EMAIL.
ALERT_EMAIL=
# Used to build links in emails (unsubscribe, event confirmations).
PUBLIC_SITE_URL=https://onctionenergy.com
