server {
    listen 80;
    server_name onctionenergy.com www.onctionenergy.com vendors.onctionenergy.com;

    # Match the backend's 200MB media upload cap
    client_max_body_size 200M;

    # Proxy everything to the Onction website frontend container
    # (it forwards /api to the backend itself)
    location / {
        proxy_pass         http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
