# Copy to .env (repo root) on the VPS before running `docker compose up -d`.
# This file feeds docker-compose.yml — it's separate from backend/.env.example,
# which is for running the backend directly (outside Docker).

POSTGRES_PASSWORD=

# openssl rand -hex 32
JWT_SECRET=

# First dashboard login — created once by `docker compose run --rm backend python -m app.seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# File storage backend: "s3" (Contabo/S3-compatible) or "interserver"
STORAGE_BACKEND=s3
# InterServer storage hosting (used when STORAGE_BACKEND=interserver).
# The FTP account's login is the API login; never commit the real password.
INTERSERVER_URL=https://storage4500.is.cc:8080
INTERSERVER_USER=apiwebstorage@st87322.ispot.cc
INTERSERVER_PASSWORD=
INTERSERVER_BASE_SUBPATH=onction-documents

# Contabo Object Storage (S3-compatible)
S3_ENDPOINT_URL=
S3_REGION=us-central-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_PUBLIC_BASE_URL=

# Only needed if the dashboard is ever served from a different origin than
# the API (not the case with this docker-compose setup — nginx proxies /api
# same-origin). Leave blank otherwise.
EXTRA_CORS_ORIGINS=

# --- Email (SMTP) — newsletters, event confirmations, admin alerts -----------
# Provider-agnostic: same fields work against a VPS mail server or an SMTP
# relay from SES/SendGrid/Mailgun later. See DEPLOY.md for the deliverability
# tradeoffs of sending bulk mail straight from the VPS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@onctionenergy.com
SMTP_FROM_NAME=Onction Energy
ALERT_EMAIL=
PUBLIC_SITE_URL=https://onctionenergy.com
